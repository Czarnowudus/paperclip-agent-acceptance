#!/usr/bin/env python3
"""sum-cli: sum numbers given as arguments (or on stdin).

Usage:
  sum-cli 1 2 3        # prints 6
  sum-cli 1.5 2.5      # prints 4
  echo "1\n2" | sum-cli # prints 3 (numbers read from stdin when no args)
"""

import sys


def parse_number(token: str):
    """Parse a token as int or float, raising ValueError on failure."""
    try:
        return int(token)
    except ValueError:
        return float(token)


def main(argv):
    tokens = argv[1:]
    if tokens and tokens[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    if not tokens:
        tokens = sys.stdin.read().split()

    total = 0
    try:
        for token in tokens:
            total += parse_number(token)
    except ValueError:
        print(f"sum-cli: invalid number: {token!r}", file=sys.stderr)
        return 1

    print(total)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))